# Copy to .env and fill in real values before deploying

# Backend
MONGODB_URI=mongodb://localhost:27017/heartlink
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Photo storage — "local" for dev/testing, "s3" once you deploy to AWS
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
LOCAL_BASE_URL=http://localhost:8080/uploads

# Only needed when STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Password reset emails — leave SMTP_HOST blank in dev to just log the
# reset link to the backend console instead of actually sending an email.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_EMAIL=no-reply@heartlink.app

# Frontend (optional, used only if you don't proxy through nginx/docker-compose)
VITE_API_TARGET=http://localhost:8080
